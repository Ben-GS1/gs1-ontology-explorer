# Base URL of the GitHub Pages site hosting the JSON-LD definitions.
VITE_DEFINITIONS_BASE_URL=https://gs1-switzerland.github.io/WebOntology

# Path (relative to VITE_DEFINITIONS_BASE_URL) of the published catalog manifest.
VITE_MANIFEST_PATH=registry/manifest.jsonld

# Path (relative to VITE_DEFINITIONS_BASE_URL) of the GS1 sector codelist.
VITE_SECTORS_PATH=registry/sectors.jsonld

# Public resolver host used to render permalinks, e.g. https://ref.gs1.ch
VITE_RESOLVER_HOST=https://ref.gs1.ch
